{
  "name": "packwatch",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:dev && node tests/e2e/smoke.cjs",
    "perf": "npm run build:dev && node tests/e2e/perf.cjs",
    "fixture-shop": "node fixture-shop/server.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "test:restart": "npm run build:dev && node tests/e2e/restart.cjs",
    "test:monitor": "npm run build:dev && node tests/e2e/monitor.cjs",
    "backtest": "node tests/e2e/backtest-live.cjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "extpay": "^3.1.2",
    "qrcode-generator": "^2.0.4"
  }
}
